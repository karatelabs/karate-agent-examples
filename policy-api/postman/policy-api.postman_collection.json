              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"the policy is cancelled\", function () {",
                  "    pm.response.to.have.status(204);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/policies/{{policyId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "policies",
                "{{policyId}}"
              ]
            }
          },
          "response": []
        },
        {
          "name": "Get the cancelled policy",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"a cancelled policy stays readable\", function () {",
                  "    pm.response.to.have.status(200);",
                  "    pm.expect(pm.response.json().status).to.eql(\"CANCELLED\");",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
