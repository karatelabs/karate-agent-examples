{
  "info": {
    "_postman_id": "3f2b8c51-7a4e-4d0b-9e2a-61c5d8f0a9b3",
    "name": "Policy API",
    "description": "Quotes, policies and claims against openapi.yaml: price a quote, bind it, file and read a claim, cancel the policy. `baseUrl` comes from karate-config.js; each request stores the id the next one needs.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Quotes",
      "item": [
        {
          "name": "Quote a preferred driver",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"the quote is created\", function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "var quote = pm.response.json();",
                  "pm.test(\"the rate book prices it\", function () {",
                  "    pm.expect(quote.monthlyPremium).to.eql(100);",
                  "    pm.expect(quote.policyClass).to.eql(\"PREFERRED\");",
                  "    pm.expect(quote.currency).to.eql(\"USD\");",
                  "});",
                  "pm.collectionVariables.set(\"quoteId\", quote.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/quotes",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "quotes"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"state\": \"CA\",\n  \"coverage\": \"COLLISION\",\n  \"driverAge\": 45,\n  \"priorClaims\": false\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": []
        },
        {
          "name": "Quote a young driver with prior claims",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"the quote is created\", function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "pm.test(\"young-driver and prior-claims loadings apply\", function () {",
                  "    var quote = pm.response.json();",
                  "    pm.expect(quote.monthlyPremium).to.eql(140);",
                  "    pm.expect(quote.policyClass).to.eql(\"SUBSTANDARD\");",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/quotes",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "quotes"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"state\": \"NY\",\n  \"coverage\": \"LIABILITY\",\n  \"driverAge\": 22,\n  \"priorClaims\": true\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": []
        },
        {
          "name": "Reject an unrated state",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"an unrated state is a bad request\", function () {",
                  "    pm.response.to.have.status(400);",
                  "    pm.expect(pm.response.json().field).to.eql(\"state\");",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/quotes",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "quotes"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"state\": \"ZZ\",\n  \"coverage\": \"LIABILITY\",\n  \"driverAge\": 40,\n  \"priorClaims\": false\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": []
        }
      ]
    },
    {
      "name": "Policies",
      "item": [
        {
          "name": "Bind the quote",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"the policy is bound\", function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "var policy = pm.response.json();",
                  "pm.test(\"it carries the quote's price and state\", function () {",
                  "    pm.expect(policy.status).to.eql(\"BOUND\");",
                  "    pm.expect(policy.monthlyPremium).to.eql(100);",
                  "    pm.expect(policy.state).to.eql(\"CA\");",
                  "    pm.expect(policy.quoteId).to.eql(pm.collectionVariables.get(\"quoteId\"));",
                  "});",
                  "pm.collectionVariables.set(\"policyId\", policy.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/policies",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "policies"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"quoteId\": \"{{quoteId}}\",\n  \"holder\": \"Ada Lopez\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": []
        },
        {
          "name": "Get the policy",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"the bound policy reads back\", function () {",
                  "    pm.response.to.have.status(200);",
                  "    pm.expect(pm.response.json().holder).to.eql(\"Ada Lopez\");",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/policies/{{policyId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "policies",
                "{{policyId}}"
              ]
            }
          },
          "response": []
        },
        {
          "name": "List policies in CA",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"the list holds the bound policy\", function () {",
                  "    pm.response.to.have.status(200);",
                  "    var ids = pm.response.json().map(function (p) { return p.id; });",
                  "    pm.expect(ids).to.include(pm.collectionVariables.get(\"policyId\"));",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/policies?state=CA",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "policies"
              ],
              "query": [
                {
                  "key": "state",
                  "value": "CA"
                }
              ]
            }
          },
          "response": []
        },
        {
          "name": "Reject a binding for an unknown quote",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"an unknown quote is a bad request\", function () {",
                  "    pm.response.to.have.status(400);",
                  "    pm.expect(pm.response.json().field).to.eql(\"quoteId\");",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/policies",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "policies"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"quoteId\": \"q-unknown\",\n  \"holder\": \"Ada Lopez\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": []
        }
      ]
    },
    {
      "name": "Claims",
      "item": [
        {
          "name": "File a claim",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"the claim is opened\", function () {",
                  "    pm.response.to.have.status(201);",
                  "    pm.expect(pm.response.json().status).to.eql(\"OPEN\");",
                  "});",
                  "pm.collectionVariables.set(\"claimId\", pm.response.json().id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/claims",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "claims"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"policyId\": \"{{policyId}}\",\n  \"amount\": 500\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": []
        },
        {
          "name": "Get the claim",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"the claim reads back\", function () {",
                  "    pm.response.to.have.status(200);",
                  "    var claim = pm.response.json();",
                  "    pm.expect(claim.amount).to.eql(500);",
                  "    pm.expect(claim.policyId).to.eql(pm.collectionVariables.get(\"policyId\"));",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/claims/{{claimId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "claims",
                "{{claimId}}"
              ]
            }
          },
          "response": []
        },
        {
          "name": "Get an unknown claim",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"an unknown claim is not found\", function () {",
                  "    pm.response.to.have.status(404);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/claims/c-unknown",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "claims",
                "c-unknown"
              ]
            }
          },
          "response": []
        }
      ]
    },
    {
      "name": "Cancellation",
