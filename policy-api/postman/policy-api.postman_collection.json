                "{{baseUrl}}"
              ],
              "path": [
                "policies",
                "{{policyId}}"
              ]
            }
          },
          "response": []
        },
        {
          "name": "Cancel an unknown policy",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"an unknown policy is not found\", function () {",
                  "    pm.response.to.have.status(404);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/policies/p-unknown",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "policies",
                "p-unknown"
              ]
            }
          },
          "response": []
        }
      ]
    }
