      "name": "add_item",
      "description": "Add a new item to the inventory. Fails if the sku already exists.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "sku": {
            "type": "string",
            "description": "Stock keeping unit — unique across the inventory"
          },
          "name": {
            "type": "string",
            "description": "Human readable item name"
          },
          "qty": {
            "description": "Starting quantity, defaults to 1",
            "type": "number"
          }
        },
        "required": [
          "sku",
          "name"
        ]
      },
      "execution": {
        "taskSupport": "forbidden"
